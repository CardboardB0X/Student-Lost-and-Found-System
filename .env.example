# Server Port (default: 5000)
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Atlas URI Format: mongodb+srv://<username>:<password>@<cluster-url>/campus_lost_found?retryWrites=true&w=majority
# Local URI Format: mongodb://127.0.0.1:27017/campus_lost_found
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/campus_lost_found?retryWrites=true&w=majority

# Environment Mode (development | production)
NODE_ENV=development

# JSON Web Token Secret for Authentication
JWT_SECRET=lostradar_academic_jwt_secret_key_2026_dcit26
